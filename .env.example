# Copy this file to .env and fill in your values. .env is git-ignored.

# Optional but recommended: a free CORE API key from https://core.ac.uk/services/api
# Without a key the app still works, using CORE's much lower anonymous rate limit.
CORE_API_KEY=

# Port for the API server (and for the whole app in production).
PORT=3000

# How long to wait for CORE before giving up, in milliseconds.
CORE_TIMEOUT_MS=15000
